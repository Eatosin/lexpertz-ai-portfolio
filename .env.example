# Contact form delivery (Resend). Without a key the form falls back to a
# pre-filled mailto, so a lead is never dropped — but you will not get the
# structured email. Create a key at https://resend.com/api-keys.
RESEND_API_KEY=
CONTACT_TO_EMAIL=lexpertzai@cc.cc
# Must be a verified sender/domain in Resend. The onboarding address only
# delivers to the account owner, which is fine for the first campaign.
CONTACT_FROM_EMAIL=Lexpertz AI <onboarding@resend.dev>

# Force custom events in local dev; production is enabled automatically.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
