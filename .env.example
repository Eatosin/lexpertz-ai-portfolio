# Contact form delivery (Resend). Without a key the form falls back to a
# pre-filled mailto, so a lead is never dropped — but you will not get the
# structured email. Create a key at https://resend.com/api-keys.
RESEND_API_KEY=
CONTACT_TO_EMAIL=brief@mail.lexpertzai.cc
# Must be a verified sender/domain in Resend.
CONTACT_FROM_EMAIL=Lexpertz AI <brief@mail.lexpertzai.cc>

# Force custom events in local dev; production is enabled automatically.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
